{
  "langrev": "1",
  "warnings": [
    "no-unused"
  ],
  "dependency-search-paths": [],
  "dependencies": [],
  "authors": [
    "Satheeshkumar"
  ],
  "version": "0.3.0",
  "build-dir": "build",
  "output": "build",
  "targets": {
    "mdv": {
      "type": "executable",
      "sources": [
        "src/**"
      ]
    },
    "web": {
      "type": "executable",
      "target": "wasm32",
      "no-entry": true,
      "cpu": "generic",
      "opt": "O3",
      "sources": [
        "src/**"
      ]
    }
  },
  "test-sources": [
    "test/**"
  ],
  "cpu": "native",
  "opt": "O5"
}
