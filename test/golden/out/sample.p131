## 5. Source Code Blocks

module demo;
import std::io;

fn int main(String[] args)
{
    io::printn("Hello from the native C3 Markdown engine!");
    return 0;
}

def fibonacci(n: int) -> list[int]:
    """Generate Fibonacci series up to n terms."""
    a, b = 0, 1
    result = []
    for _ in range(n):
        result.append(a)
        a, b = b, a + b
    return result

