fn SymbolEntry* lookup_symbol(String name)
{
    for (usz i = 0; i < SYMBOLS.len; i++)
    {
        if (name == SYMBOLS[i].name)
        {
            return (SymbolEntry*)&SYMBOLS[i];
        }
    }
    return null;
}
